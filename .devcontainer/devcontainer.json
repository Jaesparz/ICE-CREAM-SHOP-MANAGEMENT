{
  "name": "Entorno Heladeria (PHP + Flutter)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/var/www/html",
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "Dart-Code.flutter",
        "Dart-Code.dart-code",
        "rangav.vscode-thunder-client"
      ]
    }
  },
  "forwardPorts": [8080, 3306],
  "postCreateCommand": "cd backend && composer install || echo 'No hay composer.json aún'"
}